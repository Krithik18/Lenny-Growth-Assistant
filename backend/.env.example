# Copy to .env locally and fill in values; never commit credentials.
APP_ENV=development
APP_NAME="Lenny Growth Assistant API"
# JSON array of allowed React development origins.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Supabase direct or session-pooler PostgreSQL URL (not the HTTPS project URL).
# Include ?sslmode=require for hosted Supabase; URL-encode password special characters.
DATABASE_URL=
DATABASE_TIMEOUT_SECONDS=5

# Reserved for later integrations.
SUPABASE_URL=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GENERATION_PROVIDER=openai
OPENAI_MODEL=gpt-6-luna
# Knowledge source is pinned to the supplied ZIP in app/ingestion/source.py.
# No GitHub downloads or external knowledge fallback are used.
