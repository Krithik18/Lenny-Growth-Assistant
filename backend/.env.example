# Copy to .env locally and fill in values; never commit credentials.
APP_ENV=development
APP_NAME="Lenny Growth Assistant API"
# JSON array of allowed React development origins.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Reserved for later integrations; not required or consumed by this setup.
DATABASE_URL=
SUPABASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
TRANSCRIPTS_REPO_URL=https://github.com/ChatPRD/lennys-podcast-transcripts
