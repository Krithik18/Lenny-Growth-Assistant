      "used_context_tokens": 1963,
      "context_hit": true,
      "answer_seconds": 5.530747599899769,
      "answer": {
        "coverage": "complete",
        "insufficient_evidence": false,
        "summary": "Tolkin recommends making product reviews primarily constructive working sessions: clarify their goals, ask probing questions, frame ideas as suggestions rather than mandates, and respect the team’s deeper context.",
        "summary_citation_ids": [
          "S1",
          "S2"
        ],
        "sections": [
          {
            "heading": "Set the purpose and tone",
            "content": "Be explicit that reviews can provide accountability and inform an audience, but their primary goal is to help the team make the product better through an intellectual conversation about the work. Avoid a “firing squad” atmosphere; while discussion may sometimes get intense, it should help the team think through improvements rather than feel attacked.",
            "citation_ids": [
              "S2"
            ]
          },
          {
            "heading": "Lead with questions, not mandates",
            "content": "As a senior voice, probe and push on dimensions the team may not be considering. When offering an idea, make clear that it is a thought—not a mandate. If you have relevant context the team may not know, share it directly as context rather than disguising it as a question.",
            "citation_ids": [
              "S1"
            ]
          },
          {
            "heading": "Respect the team’s expertise",
            "content": "Tolkin’s rationale is that people closest to a problem often have the best context to solve it. The team may spend 40–60 hours a week on the problem, while a senior leader may spend only about three hours; the leader can bring breadth, while the team brings depth. Approach the review with awareness that the team has a perspective you may not have.",
            "citation_ids": [
              "S1"
            ]
          }
        ],
        "missing_topics": []
      },
