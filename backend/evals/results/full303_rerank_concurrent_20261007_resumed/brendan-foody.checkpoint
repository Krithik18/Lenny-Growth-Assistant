    {
      "chunk_id": "c9225f59-b99b-4712-803b-f357d0ab5925",
      "episode_id": "baf6c0a8-8bc5-4637-bc86-c4c8d08f5aad",
      "episode_revision_id": "d775303d-190c-4b9d-bd73-f5d81ebee3cb",
      "title": "Why experts writing AI evals is creating the fastest-growing companies in history | Brendan Foody",
      "guest": "Brendan Foody",
