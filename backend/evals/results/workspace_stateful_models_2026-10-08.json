        "artifact": {
          "title": "Simple Calculator",
          "language": "html",
          "content": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Simple Calculator</title>\n  <style>\n    :root { color-scheme: light; font-family: system-ui, sans-serif; }\n    * { box-sizing: border-box; }\n    body {\n      min-height: 100vh; margin: 0; display: grid; place-items: center;\n      padding: 1rem; background: #eef2f7; color: #172033;\n    }\n    .calculator {\n      width: min(100%, 340px); padding: 1rem; border-radius: 1.25rem;\n      background: #fff; box-shadow: 0 12px 36px #17203320;\n    }\n    .display {\n      min-height: 5.5rem; margin-bottom: 1rem; padding: 1rem .75rem;\n      display: flex; align-items: end; justify-content: end; overflow: hidden;\n      border-radius: .8rem; background: #f3f5f9; font-size: clamp(2rem, 10vw, 3rem);\n      font-variant-numeric: tabular-nums; white-space: nowrap;\n    }\n    .keys { display: grid; grid-template-columns: repeat(4, 1fr); gap: .65rem; }\n    button {\n      min-height: 3.6rem; border: 0; border-radius: .8rem; background: #e9edf4;\n      color: inherit; font: inherit; font-size: 1.2rem; cursor: pointer;\n      transition: filter .15s, transform .08s;\n    }\n    button:hover { filter: brightness(.96); }\n    button:active { transform: scale(.97); }\n    button:focus-visible { outline: 3px solid #315fe8; outline-offset: 2px; }\n    .utility { background: #dce4f3; }\n    .operator { background: #dbe6ff; color: #173fbd; }\n    .equals { background: #315fe8; color: white; }\n    .zero { grid-column: span 2; }\n  </style>\n</head>\n<body>\n  <main class=\"calculator\" aria-label=\"Calculator\">\n    <output class=\"display\" id=\"display\" aria-live=\"polite\" aria-atomic=\"true\">0</output>\n    <div class=\"keys\" id=\"keys\">\n      <button class=\"utility\" type=\"button\" data-action=\"clear\" aria-label=\"Clear\">AC</button>\n      <button class=\"utility\" type=\"button\" data-action=\"sign\" aria-label=\"Toggle sign\">±</button>\n      <button class=\"utility\" type=\"button\" data-action=\"percent\" aria-label=\"Percent\">%</button>\n      <button class=\"operator\" type=\"button\" data-operator=\"/\" aria-label=\"Divide\">÷</button>\n\n      <button type=\"button\" data-digit=\"7\">7</button>\n      <button type=\"button\" data-digit=\"8\">8</button>\n      <button type=\"button\" data-digit=\"9\">9</button>\n      <button class=\"operator\" type=\"button\" data-operator=\"*\" aria-label=\"Multiply\">×</button>\n\n      <button type=\"button\" data-digit=\"4\">4</button>\n      <button type=\"button\" data-digit=\"5\">5</button>\n      <button type=\"button\" data-digit=\"6\">6</button>\n      <button class=\"operator\" type=\"button\" data-operator=\"-\" aria-label=\"Subtract\">−</button>\n\n      <button type=\"button\" data-digit=\"1\">1</button>\n      <button type=\"button\" data-digit=\"2\">2</button>\n      <button type=\"button\" data-digit=\"3\">3</button>\n      <button class=\"operator\" type=\"button\" data-operator=\"+\" aria-label=\"Add\">+</button>\n\n      <button class=\"zero\" type=\"button\" data-digit=\"0\">0</button>\n      <button type=\"button\" data-action=\"decimal\" aria-label=\"Decimal point\">.</button>\n      <button class=\"equals\" type=\"button\" data-action=\"equals\" aria-label=\"Equals\">=</button>\n    </div>\n  </main>\n\n  <script>\n    const display = document.getElementById('display');\n    const keys = document.getElementById('keys');\n    let current = '0';\n    let stored = null;\n    let pendingOperator = null;\n    let waitingForOperand = false;\n    let repeatOperator = null;\n    let repeatOperand = null;\n    let hasError = false;\n\n    function show() { display.textContent = current; }\n\n    function cleanNumber(value) {\n      if (!Number.isFinite(value)) return null;\n      const rounded = Number(value.toPrecision(12));\n      return Object.is(rounded, -0) ? 0 : rounded;\n    }\n\n    function calculate(a, b, operator) {\n      if (operator === '+') return cleanNumber(a + b);\n      if (operator === '-') return cleanNumber(a - b);\n      if (operator === '*') return cleanNumber(a * b);\n      if (operator === '/') return b === 0 ? null : cleanNumber(a / b);\n      return b;\n    }\n\n    function resetAll() {\n      current = '0'; stored = null; pendingOperator = null;\n      waitingForOperand = false; repeatOperator = null; repeatOperand = null;\n      hasError = false; show();\n    }\n\n    function enterDigit(digit) {\n      if (hasError) resetAll();\n      repeatOperator = null; repeatOperand = null;\n      if (waitingForOperand) {\n        current = digit; waitingForOperand = false;\n      } else if (current === '0') {\n        current = digit;\n      } else if (current.replace('-', '').length < 14) {\n        current += digit;\n      }\n      show();\n    }\n\n    function enterDecimal() {\n      if (hasError) resetAll();\n      repeatOperator = null; repeatOperand = null;\n      if (waitingForOperand) { current = '0.'; waitingForOperand = false; }\n      else if (!current.includes('.')) current += '.';\n      show();\n    }\n\n    function chooseOperator(operator) {\n      if (hasError) return;\n      const value = Number(current);\n      repeatOperator = null; repeatOperand = null;\n      if (pendingOperator && !waitingForOperand) {\n        const result = calculate(stored, value, pendingOperator);\n        if (result === null) return showError();\n        current = String(result); stored = result; show();\n      } else {\n        stored = value;\n      }\n      pendingOperator = operator;\n      waitingForOperand = true;\n    }\n\n    function equals() {\n      if (hasError) return;\n      if (pendingOperator) {\n        const operand = waitingForOperand ? stored : Number(current);\n        const result = calculate(stored, operand, pendingOperator);\n        if (result === null) return showError();\n        repeatOperator = pendingOperator; repeatOperand = operand;\n        current = String(result); stored = null; pendingOperator = null;\n        waitingForOperand = true; show();\n      } else if (repeatOperator) {\n        const result = calculate(Number(current), repeatOperand, repeatOperator);\n        if (result === null) return showError();\n        current = String(result); waitingForOperand = true; show();\n      }\n    }\n\n    function showError() {\n      current = 'Cannot divide by zero';\n      stored = null; pendingOperator = null; waitingForOperand = true;\n      repeatOperator = null; repeatOperand = null; hasError = true; show();\n    }\n\n    function performAction(action) {\n      if (action === 'clear') return resetAll();\n      if (hasError) return;\n      if (action === 'equals') return equals();\n      if (action === 'decimal') return enterDecimal();\n      if (action === 'sign') {\n        if (Number(current) !== 0) current = String(-Number(current));\n        repeatOperator = null; repeatOperand = null; show();\n      }\n      if (action === 'percent') {\n        current = String(cleanNumber(Number(current) / 100));\n        repeatOperator = null; repeatOperand = null; show();\n      }\n      if (action === 'backspace') {\n        repeatOperator = null; repeatOperand = null;\n        if (waitingForOperand) return;\n        current = current.length <= 1 || (current.length === 2 && current.startsWith('-'))\n          ? '0' : current.slice(0, -1);\n        show();\n      }\n    }\n\n    keys.addEventListener('click', (event) => {\n      const button = event.target.closest('button');\n      if (!button) return;\n      if (button.dataset.digit !== undefined) enterDigit(button.dataset.digit);\n      else if (button.dataset.operator) chooseOperator(button.dataset.operator);\n      else if (button.dataset.action) performAction(button.dataset.action);\n    });\n\n    document.addEventListener('keydown', (event) => {\n      if (/^[0-9]$/.test(event.key)) { event.preventDefault(); enterDigit(event.key); }\n      else if (event.key === '.') { event.preventDefault(); enterDecimal(); }\n      else if (['+', '-', '*', '/'].includes(event.key)) { event.preventDefault(); chooseOperator(event.key); }\n      else if (event.key === 'Enter' || event.key === '=') { event.preventDefault(); equals(); }\n      else if (event.key === 'Backspace') { event.preventDefault(); performAction('backspace'); }\n      else if (event.key === 'Escape') { event.preventDefault(); resetAll(); }\n      else if (event.key === '%') { event.preventDefault(); performAction('percent'); }\n    });\n  </script>\n</body>\n</html>"
