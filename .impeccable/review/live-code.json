{
  "message": "A self-contained, responsive growth calculator with accessible inputs and live projections.",
  "artifact": {
    "title": "User Growth Calculator",
    "language": "html",
    "content": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>User Growth Calculator</title>\n  <style>\n    :root {\n      color-scheme: light;\n      font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n      color: #19372a;\n      background: #f3f8f4;\n    }\n    * { box-sizing: border-box; }\n    body { margin: 0; padding: 2rem 1rem; }\n    main {\n      width: min(100%, 560px);\n      margin: 3rem auto;\n      padding: clamp(1.5rem, 5vw, 2.5rem);\n      background: #fff;\n      border: 1px solid #dce9df;\n      border-radius: 1.25rem;\n      box-shadow: 0 12px 36px rgb(25 55 42 / 8%);\n    }\n    h1 { margin: 0 0 .5rem; font-size: clamp(1.7rem, 5vw, 2.2rem); }\n    .intro { margin: 0 0 2rem; color: #557064; line-height: 1.5; }\n    .fields { display: grid; gap: 1.2rem; }\n    label { display: grid; gap: .45rem; font-weight: 650; }\n    input {\n      width: 100%;\n      padding: .8rem .9rem;\n      border: 1px solid #b9cfc0;\n      border-radius: .65rem;\n      background: #fbfdfb;\n      color: inherit;\n      font: inherit;\n    }\n    input:focus-visible { outline: 3px solid #8cc69c; outline-offset: 2px; }\n    .result {\n      margin-top: 2rem;\n      padding: 1.25rem;\n      border-radius: .9rem;\n      background: #eaf5ec;\n      text-align: center;\n    }\n    .result-label { margin: 0; color: #466451; font-weight: 600; }\n    output { display: block; margin-top: .35rem; color: #176336; font-size: clamp(2rem, 8vw, 3rem); font-weight: 750; }\n    .formula { margin: .6rem 0 0; color: #557064; font-size: .9rem; }\n    @media (min-width: 520px) { .fields { grid-template-columns: 1fr 1fr; } .fields label:first-child { grid-column: 1 / -1; } }\n  </style>\n</head>\n<body>\n  <main>\n    <h1>User Growth Calculator</h1>\n    <p class=\"intro\">Estimate how your user base could grow with a steady monthly growth rate.</p>\n\n    <div class=\"fields\">\n      <label for=\"starting-users\">Starting users\n        <input id=\"starting-users\" type=\"number\" min=\"0\" step=\"1\" value=\"1000\" inputmode=\"numeric\">\n      </label>\n      <label for=\"growth-rate\">Monthly growth (%)\n        <input id=\"growth-rate\" type=\"number\" min=\"-100\" step=\"0.1\" value=\"8\" inputmode=\"decimal\">\n      </label>\n      <label for=\"months\">Number of months\n        <input id=\"months\" type=\"number\" min=\"0\" step=\"1\" value=\"12\" inputmode=\"numeric\">\n      </label>\n    </div>\n\n    <section class=\"result\" aria-label=\"Projection result\">\n      <p class=\"result-label\">Projected users</p>\n      <output id=\"projection\" aria-live=\"polite\" for=\"starting-users growth-rate months\">2,518</output>\n      <p class=\"formula\">Compounded monthly, rounded to the nearest whole user.</p>\n    </section>\n  </main>\n\n  <script>\n    const startingUsers = document.querySelector(\"#starting-users\");\n    const growthRate = document.querySelector(\"#growth-rate\");\n    const months = document.querySelector(\"#months\");\n    const projection = document.querySelector(\"#projection\");\n    const formatter = new Intl.NumberFormat(undefined, { maximumFractionDigits: 0 });\n\n    function updateProjection() {\n      const users = Math.max(0, Number(startingUsers.value) || 0);\n      const rate = Math.max(-100, Number(growthRate.value) || 0) / 100;\n      const monthCount = Math.max(0, Math.floor(Number(months.value) || 0));\n      const projected = users * Math.pow(1 + rate, monthCount);\n      projection.textContent = formatter.format(Math.round(projected));\n    }\n\n    [startingUsers, growthRate, months].forEach(input => {\n      input.addEventListener(\"input\", updateProjection);\n    });\n    updateProjection();\n  </script>\n</body>\n</html>"
  },
